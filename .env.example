APP_ENV=dev
APP_TITLE=Agent Marketplace Backend
APP_DEBUG=false
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_marketplace
APP_REDIS_URL=redis://localhost:6379/0
APP_JWT_SECRET_KEY=dev-jwt-secret-key-with-32-bytes-min
APP_JWT_ACCESS_TOKEN_EXPIRY=900
APP_JWT_REFRESH_TOKEN_EXPIRY=604800
APP_SIWE_DOMAIN=127.0.0.1
APP_SIWE_NONCE_EXPIRY=300
APP_WALLET_CHANGE_COOLDOWN=604800
APP_API_KEY_PREFIX=amp_
APP_API_KEY_TOUCH_INTERVAL=300
APP_DB_STATEMENT_TIMEOUT_MS=30000
APP_DB_LOCK_TIMEOUT_MS=5000
APP_DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
APP_DB_APPLICATION_NAME=agent-marketplace-api
APP_API_RATE_LIMIT=120/minute
APP_LOG_LEVEL=INFO
APP_WORKER_SHUTDOWN_TIMEOUT_SECONDS=25
# Every paid price's payTo. Set a Base Sepolia address you control to price paid
# endpoints; staging and prod refuse to start without it.
# APP_TREASURY_ADDRESS=0x...
APP_PAYMENT_NETWORK=eip155:84532
APP_PAYMENT_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
APP_MIN_PRICE_AMOUNT=10000
APP_PLATFORM_FEE_BPS=1000
APP_PAYMENT_MAX_TIMEOUT_SECONDS=120
# Fernet keys that encrypt provider signing secrets at rest, comma-separated (the first
# encrypts, every key decrypts). Staging and prod refuse to start without one; without
# one no signing secret can be issued. Generate a key with
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_PROVIDER_SECRET_ENCRYPTION_KEYS=
APP_PROVIDER_SECRET_GRACE_SECONDS=86400
APP_REQUEST_VALIDATION_TIMEOUT_MS=250
APP_REQUEST_VALIDATION_WORKERS=2
APP_REQUEST_SCHEMA_COMPILE_TIMEOUT_MS=100
APP_DEMO_UPSTREAM_BASE_URL=https://provider.example.com
APP_DEMO_FREE_UPSTREAM_PATH=/demo/free-ping
APP_DEMO_PAID_UPSTREAM_PATH=/demo/paid-summary
